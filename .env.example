# ---- Database (Vercel Postgres / Neon / Supabase / local) ----
# Provide ONE of these. Vercel Postgres sets POSTGRES_URL automatically;
# locally you can use DATABASE_URL pointing at any Postgres instance.
DATABASE_URL=
# POSTGRES_URL=            # used as fallback if DATABASE_URL is empty

# ---- Admin dashboard ----
# Password for the /admin dashboard. Set a strong value in production.
ADMIN_PASSWORD=change-me-in-production
# Optional salt to harden the admin session cookie (any random string).
ADMIN_SESSION_SALT=onboarding-admin-salt

# ---- Optional: forward intake to the existing n8n automation ----
# If set, /api/intake POSTs the submission to this webhook (W2 intake processor),
# so the n8n automation and its Google Sheet stay in sync. Leave empty to skip.
N8N_INTAKE_WEBHOOK_URL=

# ---- Site ----
NEXT_PUBLIC_SITE_NAME="Onboardly"
NEXT_PUBLIC_SITE_URL=http://localhost:3000
